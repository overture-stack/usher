{
  "$schema": "./principals.schema.json",
  "about": {
    "purpose": "Conformance inputs: a principal and the PermissionsPayload an application is handed on their behalf. Never an expectation; what should be served lives in expectations.json.",
    "payloadShape": "security-workflow.md, The payload as a type",
    "derivedFrom": "token-calculation.md, The cases that force each branch",
    "readFirst": "README.md in this directory, which records two deliberate divergences from the case table",
    "temporalClaims": "iat and exp are a fixed reference instant of 2026-01-01T00:00:00Z. The corpus does not evaluate them; token issuance and verification are out of its scope."
  },
  "omitted": [
    {
      "case": "25",
      "reason": "A grant pairing record.delete with a field category is refused at writing, so no token exists. Deletion takes the whole record, which makes the pairing meaningless. This belongs to Usher's own schema tests, where the constraint is field_category_id IS NOT NULL."
    }
  ],
