{
  "clients": [
    {
      "clientId": "usher-directory",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${USHER_DIRECTORY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "usher-ui",
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "usher-management"
          },
          "name": "audience usher-management",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": true,
      "standardFlowEnabled": false
    }
  ],
  "enabled": true,
  "realm": "overture",
  "roles": {
    "realm": [{ "name": "usher-platform-admin" }]
  },
  "users": [
    {
      "clientRoles": {
        "realm-management": ["query-users", "view-users"]
      },
      "enabled": true,
      "serviceAccountClientId": "usher-directory",
      "username": "service-account-usher-directory"
    }
  ]
}
